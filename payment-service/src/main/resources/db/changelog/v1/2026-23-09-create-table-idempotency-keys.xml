<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-idempotency-keys" author="Bulat">

        <createTable tableName="idempotency_keys">

            <column name="id" type="UUID">
                <constraints
                        primaryKey="true"
                        nullable="false"
                        primaryKeyName="pk_payment_idempotency_keys"/>
            </column>

            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="idempotency_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="payment_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="idempotency_keys"
                columnNames="user_id, idempotency_key"
                constraintName="uk_payment_idempotency_user_key"/>

        <createIndex
                tableName="idempotency_keys"
                indexName="idx_payment_idempotency_payment_id">

            <column name="payment_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>