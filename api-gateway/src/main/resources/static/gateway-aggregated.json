{
  "openapi": "3.0.1",
  "info": {
    "title": "Gateway Aggregated APIs",
    "description": "Агрегированные эндпоинты API Gateway, объединяющие данные из микросервисов",
    "version": "1.0.0"
  },
  "paths": {
    "/events/{eventId}/availability": {
      "get": {
        "tags": ["Event Availability"],
        "summary": "Получить актуальную доступность мест события",
        "description": "Агрегирует базовую информацию о событии и структуре зала (из Event Service) с актуальным статусом бронирования каждого места (из Booking Service).",
        "operationId": "getAvailability",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "description": "Уникальный идентификатор события",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "123e4567-e89b-12d3-a456-426614174000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешное получение данных о доступности",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Невалидный UUID события"
          },
          "404": {
            "description": "Событие не найдено"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventDetailsResponse": {
        "type": "object",
        "description": "Агрегированная информация о событии с актуальной доступностью мест",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор события",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "venueId": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор площадки",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "venueSize": {
            "$ref": "#/components/schemas/VenueSizeDto",
            "description": "Информация о размере и вместимости площадки"
          },
          "name": {
            "type": "string",
            "description": "Название события",
            "example": "Рок-концерт 'Легенды'"
          },
          "description": {
            "type": "string",
            "description": "Описание события"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "Дата и время начала события",
            "example": "2023-11-15T19:00:00+03:00"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "description": "Дата и время окончания события",
            "example": "2023-11-15T22:00:00+03:00"
          },
          "status": {
            "type": "string",
            "description": "Текущий статус события",
            "example": "PUBLISHED"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Дата создания записи"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Дата последнего обновления"
          },
          "sections": {
            "type": "array",
            "description": "Список секций зала с информацией о доступности мест в каждой",
            "items": {
              "$ref": "#/components/schemas/EventSectionDetailsResponseDto"
            }
          }
        }
      },
      "VenueSizeDto": {
        "type": "object",
        "description": "Информация о размерах площадки",
        "properties": {
          "width": { "type": "integer", "description": "Ширина площадки" },
          "height": { "type": "integer", "description": "Высота площадки" }
        }
      },
      "EventSectionDetailsResponseDto": {
        "type": "object",
        "description": "Информация о секции зала с детализацией мест",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор связи секции с событием",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор события",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор базовой секции площадки",
            "example": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
          },
          "name": {
            "type": "string",
            "description": "Название секции",
            "example": "Партер"
          },
          "x": {
            "type": "integer",
            "description": "Координата X левого верхнего угла секции на схеме",
            "example": 100
          },
          "y": {
            "type": "integer",
            "description": "Координата Y левого верхнего угла секции на схеме",
            "example": 200
          },
          "width": {
            "type": "integer",
            "description": "Ширина области секции на схеме",
            "example": 500
          },
          "height": {
            "type": "integer",
            "description": "Высота области секции на схеме",
            "example": 300
          },
          "rotation": {
            "type": "integer",
            "description": "Угол поворота секции на схеме (в градусах)",
            "example": 0
          },
          "seats": {
            "type": "array",
            "description": "Список всех мест в данной секции",
            "items": {
              "$ref": "#/components/schemas/EventSeatDetailsResponseDto"
            }
          }
        }
      },
      "EventSeatDetailsResponseDto": {
        "type": "object",
        "description": "Детальная информация о конкретном месте в секции",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор места в контексте события",
            "example": "c3d4e5f6-a7b8-9012-cdef-123456789012"
          },
          "eventSectionId": {
            "type": "string",
            "format": "uuid",
            "description": "Идентификатор родительской секции",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "seatId": {
            "type": "string",
            "format": "uuid",
            "description": "Уникальный идентификатор физического места на площадке",
            "example": "d4e5f6a7-b8c9-0123-defg-234567890123"
          },
          "status": {
            "type": "string",
            "description": "Текущий статус доступности места",
            "example": "FREE"
          },
          "price": {
            "type": "number",
            "format": "decimal",
            "description": "Стоимость билета на это место",
            "example": 1500.00
          },
          "rowNumber": {
            "type": "integer",
            "description": "Номер ряда",
            "example": 5
          },
          "seatNumber": {
            "type": "integer",
            "description": "Номер места в ряду",
            "example": 12
          },
          "x": {
            "type": "integer",
            "description": "Координата X места на схеме",
            "example": 150
          },
          "y": {
            "type": "integer",
            "description": "Координата Y места на схеме",
            "example": 250
          },
          "width": {
            "type": "integer",
            "description": "Ширина места на схеме",
            "example": 40
          },
          "height": {
            "type": "integer",
            "description": "Высота места на схеме",
            "example": 40
          },
          "rotation": {
            "type": "integer",
            "description": "Угол поворота места на схеме",
            "example": 0
          }
        }
      }
    }
  }
}