<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="002-create-table-sections" author="Bulat">

        <createTable tableName="sections">

            <column name="id" type="UUID">
                <constraints
                        primaryKey="true"
                        nullable="false"
                        primaryKeyName="pk_sections"/>
            </column>

            <column name="venue_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="x" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="y" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="width" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="height" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="rotation" type="INTEGER">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="sections"
                baseColumnNames="venue_id"
                referencedTableName="venues"
                referencedColumnNames="id"
                constraintName="fk_sections_venue"/>

        <addUniqueConstraint
                tableName="sections"
                columnNames="venue_id, name"
                constraintName="uk_sections_venue_name"/>

        <createIndex
                tableName="sections"
                indexName="idx_sections_venue_id">

            <column name="venue_id"/>

        </createIndex>

    </changeSet>


</databaseChangeLog>